{
  "name": "@locio-au/vue",
  "version": "0.2.0",
  "description": "Vue address autocomplete for Australian addresses: validation, autocomplete and geocoding from G-NAF",
  "keywords": [
    "vue address autocomplete",
    "address autocomplete",
    "address validation",
    "address geocoding",
    "address validation service",
    "australian address api",
    "gnaf",
    "g-naf",
    "address lookup",
    "geocoding",
    "australia",
    "postcode",
    "vue",
    "vue3",
    "combobox",
    "typeahead"
  ],
  "license": "MIT",
  "homepage": "https://locio.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locio-au/locio-vue.git"
  },
  "bugs": {
    "url": "https://github.com/locio-au/locio-vue/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
